  "laws": [
    {"id": "RMA-01", "title": "Frozen legacy source is authority", "rule": "R0.8 MUST reconcile the machine-readable R0.0 freeze as the authoritative migration inventory and MUST NOT replace missing legacy facts with inferred ones."},
    {"id": "RMA-02", "title": "Migration map is not Birth", "rule": "A reserved migration RecordId MUST remain pre-birth until R1 materializes and admits a valid generation-zero revision under the frozen R0.2 identity contract."},
    {"id": "RMA-03", "title": "Reserved RecordIds are opaque", "rule": "Every migration RecordId MUST satisfy R0.2 grammar, MUST be globally unique within the migration registry and MUST NOT encode the legacy slug, kind, language or route."},
    {"id": "RMA-04", "title": "Legacy projects have explicit target kinds", "rule": "Every frozen legacy Project MUST map exactly once to an explicit target RecordKind or representation treatment and MUST NOT retain Project as the future ontology root."},
    {"id": "RMA-05", "title": "Guarantee labels preserve but do not self-establish", "rule": "Every frozen project guarantee label MUST be preserved either as a planned knowledge.claim or as representation text and MUST NOT acquire evidential rank during migration."},
    {"id": "RMA-06", "title": "VERIFY SYSTEMS migrates as Publication", "rule": "The legacy VERIFY SYSTEMS project identity MUST map to the same representation.publication identity as the frozen VERIFY SYSTEMS publication rather than minting a duplicate System by convenience."},
    {"id": "RMA-07", "title": "Sanitized legacy surfaces stay bounded", "rule": "Legacy private or case-study surfaces that are already publicly rendered in sanitized form MUST map only to admitted public-safe Records and MUST NOT import hidden private source material."},
    {"id": "RMA-08", "title": "Visibility decomposition is explicit", "rule": "Every migrated public project, publication and architecture target MUST receive an explicit R0.6 disclosure plan separating record visibility, source availability, Evidence availability and disclosure mode."},
    {"id": "RMA-09", "title": "Maturity is not invented", "rule": "R0.8 MAY plan maturity only when the frozen legacy surface states a compatible maturity fact and MUST leave other System maturity unclassified rather than infer progress from presentation."},
    {"id": "RMA-10", "title": "Architecture views become representations", "rule": "Every frozen Architecture Explorer view MUST map exactly once to representation.architecture and MUST preserve its principle and guarantee text without treating the diagram as Evidence."},
    {"id": "RMA-11", "title": "Architecture subjects resolve", "rule": "Every planned Architecture subject MUST resolve to a reserved knowledge.system identity, including a bounded supporting System only when that System is explicitly named in the frozen architecture source."},
    {"id": "RMA-12", "title": "Evidence catalogs reconcile by locator", "rule": "The union of frozen Evidence Room and project evidence locators MUST map exactly once by locator so duplicate catalogs do not mint duplicate evidential identities."},
    {"id": "RMA-13", "title": "Occurrence evidence requires recapture", "rule": "A frozen locator that would require an occurrence-oriented R0.4 facet MUST be marked recapture-required unless the freeze contains the required digest and observedAt provenance."},
    {"id": "RMA-14", "title": "Migration does not manufacture Evidence bindings", "rule": "R0.8 MUST NOT create supports, contradicts or qualifies relations before exact Evidence and target revisions exist; pinned Evidence bindings remain post-Birth materialization work."},
    {"id": "RMA-15", "title": "Legacy routes remain reachable by plan", "rule": "Every frozen R0.0 public route MUST appear exactly once in the compatibility route plan and MUST NOT be silently dropped or reassigned."},
    {"id": "RMA-16", "title": "Unprefixed work routes are compatibility entry points", "rule": "Legacy /work routes that served multiple client languages MUST remain language-negotiating compatibility routes and MUST NOT be misrepresented as one R0.7 language-specific Record alias."},
    {"id": "RMA-17", "title": "Home and architecture index are service routes", "rule": "The frozen root and /architecture routes MUST remain service/collection compatibility routes and MUST NOT be forced into a single Record identity."},
    {"id": "RMA-18", "title": "Target Record routes obey R0.7", "rule": "Every planned canonical Record route MUST satisfy the frozen R0.7 locale, namespace and slug grammar, while translations remain optional and exact-revision-bound after Birth."},
    {"id": "RMA-19", "title": "Runtime incompatibilities are explicit", "rule": "Observed legacy runtime behaviors that conflict with the frozen target contracts MUST remain explicit deferred R1 corrections and MUST NOT be silently claimed as fixed by R0.8."},
    {"id": "RMA-20", "title": "R0 closes only with zero semantic loss", "rule": "R0_COMPLETE MUST remain false until executable reconciliation proves full frozen inventory coverage, zero unresolved migration entries, zero semantic-loss entries and a successful Verify witness."}
  ],
