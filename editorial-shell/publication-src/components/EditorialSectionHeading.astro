---
interface Props {
  index: string;
  label: string;
  title: string;
  note?: string;
}

const { index, label, title, note } = Astro.props;
---
<header class="editorial-section-heading">
  <div class="editorial-section-index">{index}</div>
  <div>
    <p class="editorial-section-label">{label}</p>
    <h2>{title}</h2>
  </div>
  {note && <p class="editorial-section-note">{note}</p>}
</header>
