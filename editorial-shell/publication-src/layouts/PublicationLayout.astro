---
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  kind?: string;
  publishedAt?: string;
  ogImagePath?: string;
  ogImageAlt?: string;
  topics?: string[];
}

const {
  title,
  description,
  canonicalUrl,
  kind,
  publishedAt,
  ogImagePath = '/og.png',
  ogImageAlt = title,
  topics = [],
} = Astro.props;
const isArticle = Boolean(kind);
const ogImageUrl = new URL(ogImagePath, Astro.site);
if (publishedAt) ogImageUrl.searchParams.set('v', publishedAt.slice(0, 10).replaceAll('-', ''));
const ogImage = ogImageUrl.toString();
const structuredData = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: [ogImage],
      datePublished: publishedAt,
      dateModified: publishedAt,
      mainEntityOfPage: canonicalUrl,
      articleSection: 'Editorial',
      keywords: topics,
      author: {
        '@type': 'Person',
        name: 'Renan Melo',
        url: 'https://renan.snelabs.space/',
      },
      publisher: {
        '@type': 'Person',
        name: 'Renan Melo',
        url: 'https://renan.snelabs.space/',
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: title,
      description,
      url: canonicalUrl,
      author: {
        '@type': 'Person',
        name: 'Renan Melo',
        url: 'https://renan.snelabs.space/',
      },
    };
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Renan Melo" />
    <meta name="theme-color" content="#08090d" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Renan Melo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {isArticle && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {isArticle && <meta property="article:author" content="https://renan.snelabs.space/" />}
    {isArticle && <meta property="article:section" content="Editorial" />}
    {isArticle && topics.map((topic) => <meta property="article:tag" content={topic} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="identity" href="/">
        <span class="mark">RM</span>
        <span><strong>RENAN MELO</strong><small>EDITORIAL</small></span>
      </a>
      <nav>
        <a href="/">PORTFÓLIO</a>
        <a class="active" href="/editorial/">EDITORIAL</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer><span>RENAN MELO // EDITORIAL</span><a href="/">PORTFÓLIO →</a></footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; --bg:#08090d; --surface:#0d0f15; --surface2:#12151d; --line:#262b36; --text:#f3f5f7; --muted:#838a99; --blue:#00d9ff; --purple:#a855f7; --green:#00ff88; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  * { box-sizing: border-box; }
  body { margin:0; min-height:100vh; background:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.016) 1px,transparent 1px),var(--bg); background-size:48px 48px; color:var(--text); }
  a { color:inherit; }
  .topbar, footer { width:min(1440px, calc(100% - 32px)); margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .topbar { min-height:72px; border-bottom:1px solid var(--line); }
  .identity { display:flex; align-items:center; gap:12px; text-decoration:none; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; }
  .identity .mark { display:grid; place-items:center; width:34px; height:34px; border:1px solid var(--blue); color:var(--blue); font-size:11px; font-weight:800; }
  .identity strong { display:block; font-size:11px; letter-spacing:.08em; }
  .identity small { display:block; margin-top:4px; color:var(--muted); font-size:9px; letter-spacing:.14em; }
  nav { display:flex; gap:20px; font:11px/1 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; }
  nav a { color:var(--muted); text-decoration:none; }
  nav a:hover, nav a.active { color:var(--blue); }
  main { width:min(1120px, calc(100% - 40px)); margin:0 auto; padding:84px 0 120px; }
  .kicker { color:var(--purple); font:600 11px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.12em; text-transform:uppercase; }
  h1 { max-width:960px; margin:18px 0 22px; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:clamp(46px,7vw,88px); line-height:.96; letter-spacing:-.055em; }
  .dek { max-width:820px; margin:0; color:#c5c9d1; font-size:clamp(19px,2.2vw,27px); line-height:1.5; }
  .meta-row { display:flex; flex-wrap:wrap; gap:10px 20px; margin-top:28px; color:var(--muted); font:11px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace; text-transform:uppercase; letter-spacing:.08em; }
  .article-grid { display:grid; grid-template-columns:minmax(0,1fr) 230px; gap:72px; margin-top:76px; padding-top:40px; border-top:1px solid var(--line); }
  article { min-width:0; }
  article h2 { margin:42px 0 14px; font:700 13px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace; color:var(--blue); letter-spacing:.09em; text-transform:uppercase; }
  article h2:first-child { margin-top:0; }
  article p { max-width:760px; margin:0 0 22px; color:#d0d3d9; font-size:18px; line-height:1.78; }
  aside { border-left:1px solid var(--line); padding-left:24px; }
  .share-label { color:var(--muted); font:10px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.1em; text-transform:uppercase; }
  .share-actions { display:grid; gap:8px; margin-top:14px; }
  .share-actions a, .share-actions button { min-height:40px; border:1px solid var(--line); background:var(--surface); color:var(--text); padding:0 12px; text-align:left; font:11px/1 ui-monospace,SFMono-Regular,Menlo,monospace; cursor:pointer; text-decoration:none; }
  .share-actions a:hover, .share-actions button:hover { border-color:var(--blue); color:var(--blue); }
  .tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:28px; }
  .tag { border:1px solid var(--line); padding:7px 9px; color:var(--muted); font:10px/1 ui-monospace,SFMono-Regular,Menlo,monospace; text-transform:uppercase; }
  .index-header { display:grid; gap:20px; margin-bottom:56px; }
  .publication-list { border:1px solid var(--line); }
  .publication-row { display:grid; grid-template-columns:120px minmax(0,1fr) auto; gap:28px; align-items:start; padding:26px; border-bottom:1px solid var(--line); text-decoration:none; background:rgba(8,9,13,.86); }
  .publication-row:last-child { border-bottom:0; }
  .publication-row:hover { background:var(--surface); }
  .publication-row .type { color:var(--purple); font:10px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.1em; }
  .publication-row h2 { margin:0 0 8px; font:700 18px/1.3 ui-monospace,SFMono-Regular,Menlo,monospace; }
  .publication-row p { margin:0; max-width:700px; color:var(--muted); line-height:1.55; }
  .publication-row .arrow { color:var(--blue); }
  footer { min-height:86px; border-top:1px solid var(--line); color:var(--muted); font:10px/1 ui-monospace,SFMono-Regular,Menlo,monospace; }
  footer a { color:var(--blue); text-decoration:none; }
  @media (max-width:760px) { .topbar { padding:18px 0; align-items:flex-start; } nav { padding-top:10px; } main { padding-top:58px; } .article-grid { grid-template-columns:1fr; gap:44px; } aside { border-left:0; border-top:1px solid var(--line); padding:24px 0 0; } .publication-row { grid-template-columns:1fr auto; } .publication-row .type { grid-column:1 / -1; } }
</style>
