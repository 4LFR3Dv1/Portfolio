---
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  kind?: string;
  publishedAt?: string;
  ogImagePath?: string;
  ogImageAlt?: string;
  topics?: string[];
}

const {
  title,
  description,
  canonicalUrl,
  kind,
  publishedAt,
  ogImagePath = '/og.png',
  ogImageAlt = title,
  topics = [],
} = Astro.props;
const isArticle = Boolean(kind);
const ogImageUrl = new URL(ogImagePath, Astro.site);
if (publishedAt) ogImageUrl.searchParams.set('v', publishedAt.slice(0, 10).replaceAll('-', ''));
const ogImage = ogImageUrl.toString();
const structuredData = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: [ogImage],
      datePublished: publishedAt,
      dateModified: publishedAt,
      mainEntityOfPage: canonicalUrl,
      articleSection: 'Editorial',
      keywords: topics,
      author: {
        '@type': 'Person',
        name: 'Renan Melo',
        url: 'https://renan.snelabs.space/',
      },
      publisher: {
        '@type': 'Person',
        name: 'Renan Melo',
        url: 'https://renan.snelabs.space/',
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: title,
      description,
      url: canonicalUrl,
      author: {
        '@type': 'Person',
        name: 'Renan Melo',
        url: 'https://renan.snelabs.space/',
      },
    };
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Renan Melo" />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Renan Melo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {isArticle && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {isArticle && <meta property="article:author" content="https://renan.snelabs.space/" />}
    {isArticle && <meta property="article:section" content="Editorial" />}
    {isArticle && topics.map((topic) => <meta property="article:tag" content={topic} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="identity" href="/">
        <span class="mark">RM</span>
        <span><strong>RENAN MELO</strong><small>EDITORIAL</small></span>
      </a>
      <nav class="topbar-nav">
        <a href="/">PORTFÓLIO</a>
        <a class="active" href="/editorial/">EDITORIAL</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer><span>RENAN MELO // EDITORIAL</span><a href="/">PORTFÓLIO →</a></footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg:#0a0a0f;
    --surface:#12121a;
    --surface2:#1a1a24;
    --line:#24242e;
    --line-strong:#3a3a44;
    --text:#e8e8ea;
    --muted:#6b6b7a;
    --blue:#00d9ff;
    --purple:#a855f7;
    --green:#00ff88;
    --amber:#ffaa00;
    --font-mono:'JetBrains Mono','Courier New',monospace;
    --font-sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    font-family:var(--font-sans);
  }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body {
    margin:0;
    min-height:100vh;
    background:
      linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.016) 1px,transparent 1px),
      var(--bg);
    background-size:48px 48px;
    color:var(--text);
    font-family:var(--font-sans);
  }
  a { color:inherit; }
  button, input { font:inherit; }
  ::selection { background:rgba(0,217,255,.22); color:var(--text); }
  .topbar, footer {
    width:min(1600px,calc(100% - 40px));
    margin:0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:24px;
  }
  .topbar { min-height:72px; border-bottom:1px solid var(--line); }
  .identity { display:flex; align-items:center; gap:12px; text-decoration:none; font-family:var(--font-mono); }
  .identity .mark { display:grid; place-items:center; width:34px; height:34px; border:1px solid var(--blue); color:var(--blue); font-size:11px; font-weight:800; }
  .identity strong { display:block; font-size:11px; letter-spacing:.08em; }
  .identity small { display:block; margin-top:4px; color:var(--muted); font-size:9px; letter-spacing:.14em; }
  .topbar-nav { display:flex; gap:20px; font:11px/1 var(--font-mono); letter-spacing:.08em; }
  .topbar-nav a { color:var(--muted); text-decoration:none; transition:color .18s ease; }
  .topbar-nav a:hover, .topbar-nav a.active { color:var(--blue); }
  main { width:min(1440px,calc(100% - 48px)); margin:0 auto; padding:72px 0 120px; }
  .kicker, .eyebrow { color:var(--purple); font:600 10px/1.4 var(--font-mono); letter-spacing:.12em; text-transform:uppercase; }
  h1, h2, h3 { font-family:var(--font-sans); }
  .dek { color:#c5c9d1; }
  footer { min-height:86px; border-top:1px solid var(--line); color:var(--muted); font:10px/1 var(--font-mono); }
  footer a { color:var(--blue); text-decoration:none; }
  @media (max-width:760px) {
    .topbar { padding:18px 0; align-items:flex-start; }
    .topbar-nav { padding-top:10px; }
    main { width:min(100% - 32px,1440px); padding-top:48px; }
  }
</style>
