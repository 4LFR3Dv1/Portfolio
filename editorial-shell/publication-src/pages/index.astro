---
import EditorialSectionHeading from '../components/EditorialSectionHeading.astro';
import PublicationLayout from '../layouts/PublicationLayout.astro';
import {
  editorialState,
  getActiveInquiries,
  getActiveThreads,
  getInquiryHref,
  getPrimaryInquiry,
  getThreadInquiries,
} from '../data/editorial';
import { publications } from '../data/publications';
import '../styles/editorial-index.css';

const canonicalUrl = new URL('/editorial/', Astro.site).toString();
const primaryInquiry = getPrimaryInquiry();
const activeInquiries = getActiveInquiries();
const activeThreads = getActiveThreads();
const featuredEssays = editorialState.featuredPublicationSlugs.map((slug) => {
  const publication = publications.find((candidate) => candidate.slug === slug);
  if (!publication) throw new Error(`Editorial state references unknown publication: ${slug}`);
  return publication;
});
---
<PublicationLayout
  title="Editorial — Renan Melo"
  description="Ensaios e investigações em andamento sobre tecnologia, computação, software, hardware e as abstrações que aparecem enquanto construo."
  canonicalUrl={canonicalUrl}
  ogImagePath="/editorial/og/editorial.png"
  ogImageAlt="Editorial de Renan Melo — perguntas, investigações e ensaios"
>
  <div class="editorial-index">
    <header class="editorial-masthead">
      <div class="editorial-masthead-copy">
        <p class="kicker">EDITORIAL // RENAN MELO</p>
        <h1>Perguntas que continuam mudando enquanto construo.</h1>
        <p class="dek">O Editorial organiza investigações em andamento e os ensaios que emergem delas. Uma publicação registra uma resposta provisória; a pergunta pode continuar aberta.</p>
      </div>
      <nav class="editorial-masthead-nav" aria-label="Navegação do Editorial">
        <a href="#agora"><span>AGORA</span><span>01</span></a>
        <a href="#ensaios"><span>ENSAIOS</span><span>02</span></a>
        <a href="#em-investigacao"><span>EM INVESTIGAÇÃO</span><span>03</span></a>
        <a href="#linhas-de-investigacao"><span>LINHAS</span><span>04</span></a>
        <a href="/"><span>PORTFÓLIO</span><span>↗</span></a>
      </nav>
    </header>

    <section class="editorial-section" id="agora" aria-labelledby="agora-title">
      <EditorialSectionHeading
        index="01"
        label="AGORA"
        title="O que estou tentando entender agora."
        note="Uma pergunta recebe prioridade editorial sem deixar de pertencer às linhas maiores que continuam em movimento."
      />
      <div class="editorial-now">
        <span class="editorial-now-mark" aria-hidden="true"></span>
        <div>
          <h3 class="editorial-now-question" id="agora-title">{primaryInquiry.question.pt}</h3>
          <p class="editorial-now-summary">{primaryInquiry.summary.pt}</p>
        </div>
        <aside class="editorial-now-side">
          <div class="editorial-now-meta">
            <span>{primaryInquiry.sourceLabel.pt}</span>
            <strong>INVESTIGAÇÃO ATIVA</strong>
            <span>{primaryInquiry.threadIds.length} LINHA{primaryInquiry.threadIds.length === 1 ? '' : 'S'} RELACIONADA{primaryInquiry.threadIds.length === 1 ? '' : 'S'}</span>
          </div>
          <a href={`#${primaryInquiry.anchor}`}>VER NA FILA →</a>
        </aside>
      </div>
    </section>

    <section class="editorial-section" id="ensaios" aria-labelledby="ensaios-title">
      <EditorialSectionHeading
        index="02"
        label="ENSAIOS"
        title="Respostas que já ganharam forma publicável."
        note="Ensaios não encerram automaticamente a investigação da qual vieram. Eles registram uma posição que pode continuar evoluindo."
      />
      <div class="editorial-essay-list" id="ensaios-title">
        {featuredEssays.map((publication) => (
          <a class="editorial-essay" href={`/editorial/${publication.slug}/`}>
            <span class="editorial-essay-meta">
              {publication.kind}<br />
              {publication.dateLabel.pt}<br />
              {publication.readTime.pt}
            </span>
            <span>
              <h3 class="editorial-essay-title">{publication.title.pt}</h3>
              <p class="editorial-essay-dek">{publication.copy.pt.dek}</p>
            </span>
            <span class="editorial-essay-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="editorial-section" id="em-investigacao" aria-labelledby="investigacao-title">
      <span id="estudos-atuais" class="editorial-anchor-alias" aria-hidden="true"></span>
      <EditorialSectionHeading
        index="03"
        label="EM INVESTIGAÇÃO"
        title="Perguntas que ainda existem."
        note="Algumas já produziram ensaios. Outras ainda não. O estado da pergunta é independente do estado da publicação."
      />
      <div class="editorial-inquiry-list" id="investigacao-title">
        {activeInquiries.map((inquiry, index) => {
          const publicationSlug = inquiry.publicationSlugs[0];
          return (
            <article class="editorial-inquiry" id={inquiry.anchor}>
              <span class="editorial-inquiry-number">{String(index + 1).padStart(2, '0')}</span>
              <div class="editorial-inquiry-meta">
                <span>{inquiry.sourceLabel.pt}</span>
                <span class="active">ATIVA</span>
              </div>
              <div>
                <h3>{inquiry.question.pt}</h3>
                <p>{inquiry.summary.pt}</p>
              </div>
              <div class="editorial-inquiry-outcome">
                {publicationSlug
                  ? <a href={getInquiryHref(inquiry)}>ENSAIO PUBLICADO ↗</a>
                  : <span>ESTUDO ABERTO</span>}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="editorial-section" id="linhas-de-investigacao" aria-labelledby="linhas-title">
      <EditorialSectionHeading
        index="04"
        label="LINHAS DE INVESTIGAÇÃO"
        title="Territórios que conectam perguntas diferentes."
        note="Linhas não são tags. Elas persistem enquanto novas perguntas, experimentos e ensaios podem aparecer dentro do mesmo território."
      />
      <div class="editorial-thread-list" id="linhas-title">
        {activeThreads.map((thread, index) => {
          const inquiries = getThreadInquiries(thread.id);
          return (
            <article class="editorial-thread">
              <span class="editorial-thread-count">{String(index + 1).padStart(2, '0')}</span>
              <h3>{thread.title.pt}</h3>
              <p>{thread.description.pt}</p>
              <span class="editorial-thread-inquiries">{inquiries.length} PERGUNTA{inquiries.length === 1 ? '' : 'S'}</span>
            </article>
          );
        })}
      </div>
    </section>
  </div>
</PublicationLayout>
