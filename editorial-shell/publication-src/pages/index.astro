---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import {
  editorialState,
  getActiveInquiries,
  getActiveThreads,
  getInquiryHref,
  getPrimaryInquiry,
  getThreadInquiries,
} from '../data/editorial';
import { publications } from '../data/publications';
import '../styles/editorial-index.css';

const canonicalUrl = new URL('/editorial/', Astro.site).toString();
const primaryInquiry = getPrimaryInquiry();
const activeInquiries = getActiveInquiries();
const activeThreads = getActiveThreads();
const featuredEssays = editorialState.featuredPublicationSlugs.map((slug) => {
  const publication = publications.find((candidate) => candidate.slug === slug);
  if (!publication) throw new Error(`Editorial state references unknown publication: ${slug}`);
  return publication;
});
const primaryThreads = activeThreads.filter((thread) => primaryInquiry.threadIds.includes(thread.id));
---
<PublicationLayout
  title="Editorial — Renan Melo"
  description="Ensaios e investigações em andamento sobre tecnologia, computação, software, hardware e as abstrações que aparecem enquanto construo."
  canonicalUrl={canonicalUrl}
  ogImagePath="/editorial/og/editorial.png"
  ogImageAlt="Editorial de Renan Melo — perguntas, investigações e ensaios"
>
  <div class="editorial-index">
    <header class="editorial-masthead">
      <div class="editorial-masthead-copy">
        <p class="kicker">EDITORIAL // RENAN MELO</p>
        <h1>O que ainda está em aberto.</h1>
        <p class="editorial-intro">Perguntas que nasceram enquanto alguma coisa precisava funcionar. Algumas já produziram ensaios; nenhuma precisa terminar porque ganhou texto.</p>
      </div>

      <aside class="editorial-pulse" aria-label="Estado atual do Editorial">
        <div class="pulse-status"><span></span> AO VIVO</div>
        <div class="pulse-numbers">
          <strong>{activeInquiries.length}</strong><span>PERGUNTAS ATIVAS</span>
          <strong>{featuredEssays.length}</strong><span>ENSAIOS</span>
          <strong>{activeThreads.length}</strong><span>LINHAS</span>
        </div>
        <nav class="editorial-jump" aria-label="Navegação do Editorial">
          <a href="#agora">AGORA <span>01</span></a>
          <a href="#ensaios">ENSAIOS <span>02</span></a>
          <a href="#em-investigacao">EM INVESTIGAÇÃO <span>03</span></a>
          <a href="#linhas-de-investigacao">LINHAS <span>04</span></a>
        </nav>
      </aside>
    </header>

    <section class="now-stage" id="agora" aria-labelledby="agora-title">
      <div class="section-signal"><span>01</span><strong>AGORA</strong></div>
      <a class="now-link" href={`#${primaryInquiry.anchor}`}>
        <span class="now-live" aria-hidden="true"></span>
        <div class="now-copy">
          <p class="now-source">{primaryInquiry.sourceLabel.pt} · INVESTIGAÇÃO ATIVA</p>
          <h2 id="agora-title">{primaryInquiry.question.pt}</h2>
          <p>{primaryInquiry.summary.pt}</p>
        </div>
        <div class="now-context">
          <span>EM MOVIMENTO</span>
          {primaryThreads.map((thread) => <strong>{thread.title.pt}</strong>)}
          <span class="now-arrow">IR PARA A PERGUNTA ↘</span>
        </div>
      </a>
    </section>

    <section class="essay-stage" id="ensaios" aria-labelledby="ensaios-title">
      <header class="section-intro essay-intro">
        <div class="section-signal"><span>02</span><strong>ENSAIOS</strong></div>
        <h2 id="ensaios-title">Respostas provisórias.</h2>
        <p>O texto é um estado da investigação, não seu ponto final.</p>
      </header>

      <div class="essay-composition">
        {featuredEssays.map((publication, index) => (
          <a class:list={['essay-tile', `essay-tile-${index + 1}`]} href={`/editorial/${publication.slug}/`}>
            <span class="essay-position">0{index + 1}</span>
            <div class="essay-tile-copy">
              <span class="essay-meta">{publication.kind} · {publication.dateLabel.pt} · {publication.readTime.pt}</span>
              <h3>{publication.title.pt}</h3>
              <p>{publication.copy.pt.dek}</p>
            </div>
            <span class="essay-open" aria-hidden="true">ABRIR ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="inquiry-stage" id="em-investigacao" aria-labelledby="investigacao-title">
      <span id="estudos-atuais" class="editorial-anchor-alias" aria-hidden="true"></span>
      <header class="section-intro inquiry-intro">
        <div class="section-signal"><span>03</span><strong>EM INVESTIGAÇÃO</strong></div>
        <h2 id="investigacao-title">A fila não é uma lista de posts.</h2>
        <p>Itens publicados abrem o ensaio inteiro. O que ainda não virou texto pode ser expandido aqui.</p>
      </header>

      <div class="inquiry-queue">
        {activeInquiries.map((inquiry, index) => {
          const publicationSlug = inquiry.publicationSlugs[0];
          const threadNames = inquiry.threadIds
            .map((threadId) => activeThreads.find((thread) => thread.id === threadId)?.title.pt)
            .filter(Boolean);
          const threadValue = inquiry.threadIds.join(' ');

          if (publicationSlug) {
            return (
              <a
                class="inquiry-row inquiry-row-link"
                id={inquiry.anchor}
                href={getInquiryHref(inquiry)}
                data-threads={threadValue}
              >
                <span class="inquiry-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="inquiry-source">{inquiry.sourceLabel.pt}<strong>ATIVA</strong></span>
                <span class="inquiry-copy">
                  <h3>{inquiry.question.pt}</h3>
                  <p>{inquiry.summary.pt}</p>
                </span>
                <span class="inquiry-destination">ENSAIO ↗</span>
              </a>
            );
          }

          return (
            <details class="inquiry-row inquiry-row-open" id={inquiry.anchor} data-threads={threadValue}>
              <summary>
                <span class="inquiry-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="inquiry-source">{inquiry.sourceLabel.pt}<strong>ATIVA</strong></span>
                <span class="inquiry-copy"><h3>{inquiry.question.pt}</h3></span>
                <span class="inquiry-destination">ABRIR +</span>
              </summary>
              <div class="inquiry-expanded">
                <p>{inquiry.summary.pt}</p>
                <div class="inquiry-thread-names">
                  {threadNames.map((threadName) => <span>{threadName}</span>)}
                </div>
              </div>
            </details>
          );
        })}
      </div>
    </section>

    <section class="thread-stage" id="linhas-de-investigacao" aria-labelledby="linhas-title">
      <header class="thread-intro">
        <div class="section-signal"><span>04</span><strong>LINHAS DE INVESTIGAÇÃO</strong></div>
        <h2 id="linhas-title">Territórios que atravessam projetos.</h2>
        <p>Passe por uma linha para ver quais perguntas pertencem a ela. Clique em qualquer faixa para saltar até a primeira pergunta relacionada.</p>
      </header>

      <div class="thread-field">
        {activeThreads.map((thread, index) => {
          const inquiries = getThreadInquiries(thread.id);
          const target = inquiries[0]?.anchor ?? 'em-investigacao';
          return (
            <a class="thread-band" href={`#${target}`} data-thread={thread.id}>
              <span class="thread-index">0{index + 1}</span>
              <span class="thread-title">{thread.title.pt}</span>
              <span class="thread-description">{thread.description.pt}</span>
              <span class="thread-related">
                {inquiries.map((inquiry) => <span>{inquiry.question.pt}</span>)}
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </div>

  <script>
    const root = document.querySelector('.editorial-index');
    const threadBands = document.querySelectorAll('[data-thread]');

    for (const band of threadBands) {
      const thread = band.getAttribute('data-thread');
      const activate = () => root?.setAttribute('data-highlight-thread', thread ?? '');
      const clear = () => root?.removeAttribute('data-highlight-thread');
      band.addEventListener('mouseenter', activate);
      band.addEventListener('focus', activate);
      band.addEventListener('mouseleave', clear);
      band.addEventListener('blur', clear);
    }
  </script>
</PublicationLayout>
