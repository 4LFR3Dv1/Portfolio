---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import { publications } from '../data/publications';

const canonicalUrl = new URL('/editorial/', Astro.site).toString();
---
<PublicationLayout
  title="Editorial — Renan Melo"
  description="Ensaios sobre tecnologia, computação, software, hardware e as abstrações que aparecem enquanto construo."
  canonicalUrl={canonicalUrl}
>
  <section class="index-header">
    <p class="kicker">EDITORIAL // RENAN MELO</p>
    <h1>Ideias que aparecem enquanto construo.</h1>
    <p class="dek">Reflexões sobre tecnologia, computação, software, hardware e as abstrações que normalmente só ficam visíveis quando alguma coisa precisa funcionar de verdade.</p>
  </section>

  <div class="publication-list">
    {publications.map((publication) => (
      <a class="publication-row" href={`/editorial/${publication.slug}/`}>
        <span class="type">{publication.kind}<br />{publication.dateLabel.pt}<br />{publication.readTime.pt}</span>
        <span>
          <h2>{publication.title.pt}</h2>
          <p>{publication.copy.pt.dek}</p>
        </span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</PublicationLayout>
