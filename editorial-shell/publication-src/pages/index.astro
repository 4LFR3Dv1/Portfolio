---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import {
  editorialState,
  getActiveCategories,
  getActiveInquiries,
  getCategoryInquiries,
  getInquiryHref,
  getPrimaryInquiry,
  getPublicationEditorialContext,
} from '../data/editorial';
import { publications } from '../data/publications';
import '../styles/editorial-index.css';

const canonicalUrl = new URL('/editorial/', Astro.site).toString();
const primaryInquiry = getPrimaryInquiry();
const activeInquiries = getActiveInquiries();
const queuedInquiries = activeInquiries.filter((inquiry) => inquiry.id !== primaryInquiry.id);
const activeCategories = getActiveCategories();
const featuredEssays = editorialState.featuredPublicationSlugs.map((slug) => {
  const publication = publications.find((candidate) => candidate.slug === slug);
  if (!publication) throw new Error(`Editorial state references unknown publication: ${slug}`);
  const context = getPublicationEditorialContext(slug);
  return {
    publication,
    categoryIds: context?.categories.map((category) => category.id) ?? [],
  };
});
const primaryCategories = activeCategories.filter((category) => primaryInquiry.categoryIds.includes(category.id));
const primarySourceHref = primaryInquiry.sourceId === 'genesis'
  ? '/work/genesis'
  : primaryInquiry.sourceId === 'factory'
    ? '/work/factory'
    : null;
---
<PublicationLayout
  title="Editorial — Renan Melo"
  description="Ensaios e investigações em andamento sobre tecnologia, computação, software, hardware e as abstrações que aparecem enquanto construo."
  canonicalUrl={canonicalUrl}
  ogImagePath="/editorial/og/editorial.png"
  ogImageAlt="Editorial de Renan Melo — perguntas, investigações e ensaios"
>
  <div class="editorial-index">
    <header class="editorial-masthead">
      <div class="editorial-masthead-copy">
        <p class="kicker">EDITORIAL // RENAN MELO</p>
        <h1>O que ainda está em aberto.</h1>
        <p class="editorial-intro">Perguntas que nasceram enquanto alguma coisa precisava funcionar. Algumas já produziram ensaios; nenhuma precisa terminar porque ganhou texto.</p>
      </div>

      <aside class="editorial-pulse" aria-label="Estado atual do Editorial">
        <div class="pulse-status"><span></span> AO VIVO</div>
        <div class="pulse-numbers">
          <strong>{activeInquiries.length}</strong><span>PERGUNTAS ATIVAS</span>
          <strong>{featuredEssays.length}</strong><span>ENSAIOS</span>
          <strong>{activeCategories.length}</strong><span>CATEGORIAS</span>
        </div>
        <nav class="editorial-jump" aria-label="Navegação do Editorial">
          <a href="#agora">AGORA <span>01</span></a>
          <a href="#ensaios">ENSAIOS <span>02</span></a>
          <a href="#em-investigacao">OUTRAS PERGUNTAS <span>03</span></a>
          <a href="#categorias">CATEGORIAS <span>04</span></a>
        </nav>
      </aside>
    </header>

    <section class="now-stage" id="agora" aria-labelledby="agora-title">
      <span id={primaryInquiry.anchor} class="editorial-anchor-alias" aria-hidden="true"></span>
      <div class="section-signal"><span>01</span><strong>AGORA</strong></div>
      <div class="now-link now-focus" data-categories={primaryInquiry.categoryIds.join(' ')}>
        <span class="now-live" aria-hidden="true"></span>
        <div class="now-copy">
          <p class="now-source">
            {primarySourceHref
              ? <a class="now-source-link" href={primarySourceHref}>{primaryInquiry.sourceLabel.pt}</a>
              : primaryInquiry.sourceLabel.pt}
            <span> · INVESTIGAÇÃO ATIVA</span>
          </p>
          <h2 id="agora-title">
            {primarySourceHref
              ? <a class="now-question-link" href={primarySourceHref}>{primaryInquiry.question.pt}<span aria-hidden="true">↗</span></a>
              : primaryInquiry.question.pt}
          </h2>
          <p>{primaryInquiry.summary.pt}</p>
        </div>
        <div class="now-context" aria-label="Categorias do foco atual">
          <span>CATEGORIAS</span>
          {primaryCategories.map((category) => (
            <button
              type="button"
              data-category-control={category.id}
              data-category-label={category.title.pt}
              aria-pressed="false"
            >
              <strong>{category.title.pt}</strong><span aria-hidden="true">+</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="essay-stage" id="ensaios" aria-labelledby="ensaios-title">
      <header class="section-intro essay-intro">
        <div class="section-signal"><span>02</span><strong>ENSAIOS</strong></div>
        <h2 id="ensaios-title">Respostas provisórias.</h2>
        <p>O texto é um estado da investigação, não seu ponto final.</p>
      </header>

      <div class="essay-composition">
        {featuredEssays.map(({ publication, categoryIds }, index) => (
          <a
            class:list={['essay-tile', `essay-tile-${index + 1}`]}
            href={`/editorial/${publication.slug}/`}
            data-categories={categoryIds.join(' ')}
          >
            <span class="essay-position">0{index + 1}</span>
            <div class="essay-tile-copy">
              <span class="essay-meta">{publication.kind} · {publication.dateLabel.pt} · {publication.readTime.pt}</span>
              <h3>{publication.title.pt}</h3>
              <p>{publication.copy.pt.dek}</p>
            </div>
            <span class="essay-open" aria-hidden="true">ABRIR ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="inquiry-stage" id="em-investigacao" aria-labelledby="investigacao-title">
      <span id="estudos-atuais" class="editorial-anchor-alias" aria-hidden="true"></span>
      <header class="section-intro inquiry-intro">
        <div class="section-signal"><span>03</span><strong>OUTRAS PERGUNTAS</strong></div>
        <h2 id="investigacao-title">Além do foco atual.</h2>
      </header>

      <div class="inquiry-queue">
        {queuedInquiries.map((inquiry, index) => {
          const publicationSlug = inquiry.publicationSlugs[0];
          const categoryNames = inquiry.categoryIds
            .map((categoryId) => activeCategories.find((category) => category.id === categoryId)?.title.pt)
            .filter(Boolean);
          const categoryValue = inquiry.categoryIds.join(' ');

          if (publicationSlug) {
            return (
              <a
                class="inquiry-row inquiry-row-link"
                id={inquiry.anchor}
                href={getInquiryHref(inquiry)}
                data-categories={categoryValue}
              >
                <span class="inquiry-number">{String(index + 2).padStart(2, '0')}</span>
                <span class="inquiry-source">{inquiry.sourceLabel.pt}<strong>ATIVA</strong></span>
                <span class="inquiry-copy">
                  <h3>{inquiry.question.pt}</h3>
                  <p>{inquiry.summary.pt}</p>
                </span>
                <span class="inquiry-destination">ENSAIO ↗</span>
              </a>
            );
          }

          return (
            <details class="inquiry-row inquiry-row-open" id={inquiry.anchor} data-categories={categoryValue}>
              <summary>
                <span class="inquiry-number">{String(index + 2).padStart(2, '0')}</span>
                <span class="inquiry-source">{inquiry.sourceLabel.pt}<strong>ATIVA</strong></span>
                <span class="inquiry-copy"><h3>{inquiry.question.pt}</h3></span>
                <span class="inquiry-destination">ABRIR +</span>
              </summary>
              <div class="inquiry-expanded">
                <p>{inquiry.summary.pt}</p>
                <div class="inquiry-category-names">
                  {categoryNames.map((categoryName) => <span>{categoryName}</span>)}
                </div>
              </div>
            </details>
          );
        })}
      </div>
    </section>

    <section class="category-stage" id="categorias" aria-labelledby="categorias-title">
      <header class="category-intro">
        <div class="section-signal"><span>04</span><strong>CATEGORIAS</strong></div>
        <h2 id="categorias-title">Assuntos que conectam o Editorial.</h2>
        <p>Selecione uma categoria para filtrar perguntas e ensaios. Categorias classificam o conteúdo; não apontam para uma pergunta específica.</p>
      </header>

      <div class="category-filter-state" aria-live="polite">
        <span>MOSTRANDO</span><strong data-category-status>TODAS</strong>
        <button type="button" data-category-control="" data-category-label="TODAS" aria-pressed="true">LIMPAR FILTRO</button>
      </div>

      <div class="category-field">
        {activeCategories.map((category, index) => {
          const inquiries = getCategoryInquiries(category.id);
          const publicationCount = new Set(inquiries.flatMap((inquiry) => inquiry.publicationSlugs)).size;
          return (
            <button
              type="button"
              class="category-band"
              data-category-control={category.id}
              data-category-label={category.title.pt}
              aria-pressed="false"
            >
              <span class="category-index">0{index + 1}</span>
              <strong class="category-title">{category.title.pt}</strong>
              <span class="category-description">{category.description.pt}</span>
              <span class="category-count">
                {inquiries.length} {inquiries.length === 1 ? 'PERGUNTA' : 'PERGUNTAS'} · {publicationCount} {publicationCount === 1 ? 'ENSAIO' : 'ENSAIOS'}
              </span>
            </button>
          );
        })}
      </div>
    </section>
  </div>

  <script is:inline>
    const root = document.querySelector('.editorial-index');
    const categoryControls = [...document.querySelectorAll('[data-category-control]')];
    const categorizedNodes = [...document.querySelectorAll('[data-categories]')];
    const categoryStatus = document.querySelector('[data-category-status]');
    let selectedCategory = '';

    const applyCategory = (category, updateUrl = true) => {
      selectedCategory = category || '';
      root?.classList.toggle('category-filtering', Boolean(selectedCategory));

      for (const node of categorizedNodes) {
        const categories = (node.getAttribute('data-categories') ?? '').split(' ').filter(Boolean);
        node.classList.toggle('category-match', !selectedCategory || categories.includes(selectedCategory));
      }

      for (const control of categoryControls) {
        const controlCategory = control.getAttribute('data-category-control') ?? '';
        const pressed = controlCategory === selectedCategory;
        control.setAttribute('aria-pressed', String(pressed));
      }

      const activeControl = categoryControls.find(
        (control) => (control.getAttribute('data-category-control') ?? '') === selectedCategory,
      );
      if (categoryStatus) {
        categoryStatus.textContent = activeControl?.getAttribute('data-category-label') || 'TODAS';
      }

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (selectedCategory) url.searchParams.set('categoria', selectedCategory);
        else url.searchParams.delete('categoria');
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      }
    };

    for (const control of categoryControls) {
      control.addEventListener('click', () => {
        const category = control.getAttribute('data-category-control') ?? '';
        applyCategory(category === selectedCategory ? '' : category);
      });
    }

    const initialCategory = new URL(window.location.href).searchParams.get('categoria') ?? '';
    const knownInitialCategory = categoryControls.some(
      (control) => control.getAttribute('data-category-control') === initialCategory,
    );
    applyCategory(knownInitialCategory ? initialCategory : '', false);
  </script>

  <style>
    .inquiry-intro {
      grid-template-columns: 180px minmax(0, 1fr);
    }

    @media (max-width: 980px) {
      .inquiry-intro {
        grid-template-columns: 120px minmax(0, 1fr);
      }
    }

    @media (max-width: 700px) {
      .inquiry-intro {
        grid-template-columns: 1fr;
      }
    }
  </style>
</PublicationLayout>
