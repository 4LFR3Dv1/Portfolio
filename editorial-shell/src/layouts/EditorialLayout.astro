---
interface Props {
  title: string;
  description: string;
  language: 'en' | 'pt-BR';
}

const { title, description, language } = Astro.props;
const prefix = language === 'pt-BR' ? '/pt-br' : '/en';
const labels = language === 'pt-BR'
  ? {
      home: 'Início',
      systems: 'Sistemas',
      archive: 'Arquivo',
      research: 'Pesquisa',
      essays: 'Ensaios',
      notes: 'Notas',
    }
  : {
      home: 'Home',
      systems: 'Systems',
      archive: 'Archive',
      research: 'Research',
      essays: 'Essays',
      notes: 'Notes',
    };
---
<!doctype html>
<html lang={language === 'pt-BR' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Renan Melo</title>
  </head>
  <body>
    <header class="site-header">
      <a class="identity" href={prefix}>RENAN MELO</a>
      <nav aria-label={language === 'pt-BR' ? 'Navegação editorial' : 'Editorial navigation'}>
        <a href={prefix}>{labels.home}</a>
        <a href={`${prefix}/archive`}>{labels.archive}</a>
        <a href={`${prefix}/systems`}>{labels.systems}</a>
        <a href={`${prefix}/research`}>{labels.research}</a>
        <a href={`${prefix}/essays`}>{labels.essays}</a>
        <a href={`${prefix}/notes`}>{labels.notes}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>renan.snelabs.space</span>
      <span>{language}</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #0b0d10;
    color: #ece9e2;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px),
      #0b0d10;
    background-size: 48px 48px;
  }

  a { color: inherit; }

  .site-header,
  footer {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .site-header {
    min-height: 78px;
    border-bottom: 1px solid #282b31;
  }

  .identity {
    font: 700 12px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: .14em;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 18px;
  }

  nav a {
    color: #aaa7a1;
    font-size: 13px;
    text-decoration: none;
  }

  nav a:hover { color: #fff; }

  main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 84px 0 120px;
  }

  .eyebrow,
  .meta {
    color: #8f938f;
    font: 500 11px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin: 18px 0 20px;
    font-size: clamp(42px, 7vw, 92px);
    font-weight: 520;
    line-height: .96;
    letter-spacing: -.055em;
  }

  .lede {
    max-width: 760px;
    margin: 0;
    color: #b7b3ac;
    font-size: clamp(18px, 2.1vw, 25px);
    line-height: 1.48;
  }

  .section-grid {
    display: grid;
    gap: 1px;
    margin-top: 72px;
    border: 1px solid #282b31;
    background: #282b31;
  }

  .section-block,
  .record-card {
    background: #0d0f12;
  }

  .section-block {
    padding: 30px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: baseline;
    margin-bottom: 20px;
  }

  h2 {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
  }

  .record-list {
    display: grid;
    gap: 1px;
    background: #282b31;
    border-top: 1px solid #282b31;
  }

  .record-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    padding: 22px 0;
    text-decoration: none;
  }

  .record-card + .record-card { border-top: 1px solid #282b31; }

  .record-card h3 {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 600;
  }

  .record-card p {
    max-width: 720px;
    margin: 0;
    color: #918e88;
    line-height: 1.55;
  }

  .record-card .arrow { color: #747872; }

  .system-body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(220px, .75fr);
    gap: 72px;
    margin-top: 76px;
    padding-top: 34px;
    border-top: 1px solid #282b31;
  }

  .system-copy p {
    max-width: 760px;
    color: #c4c0b8;
    font-size: 18px;
    line-height: 1.72;
  }

  .facts {
    margin: 0;
    display: grid;
    gap: 18px;
  }

  .facts div { border-top: 1px solid #282b31; padding-top: 12px; }
  .facts dt { color: #777b77; font: 500 10px/1.4 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .08em; }
  .facts dd { margin: 5px 0 0; color: #bbb7b0; font-size: 13px; overflow-wrap: anywhere; }

  .empty {
    color: #747872;
    font: 13px/1.6 ui-monospace, monospace;
  }

  footer {
    min-height: 86px;
    border-top: 1px solid #282b31;
    color: #696d69;
    font: 11px/1 ui-monospace, monospace;
  }

  @media (max-width: 760px) {
    .site-header { align-items: flex-start; padding: 22px 0; flex-direction: column; }
    nav { justify-content: flex-start; }
    main { padding-top: 58px; }
    .system-body { grid-template-columns: 1fr; gap: 42px; }
    .record-card { grid-template-columns: 1fr auto; }
  }
</style>
