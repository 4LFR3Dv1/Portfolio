---
interface Props {
  title: string;
  description: string;
  historicalMeaning: string;
  blocker: string;
}

const { title, description, historicalMeaning, blocker } = Astro.props;
---
<!doctype html>
<html lang="en" data-legacy-preserved>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,follow" />
    <title>{title}</title>
  </head>
  <body>
    <header class="legacy-header">
      <a class="legacy-identity" href="/">RENAN MELO</a>
      <div class="legacy-header-actions">
        <span class="legacy-status">HISTORICAL PUBLIC REPRESENTATION</span>
        <div class="legacy-language-switch" aria-label="Legacy language">
          <button type="button" data-legacy-language-button="en" aria-pressed="true">EN</button>
          <button type="button" data-legacy-language-button="pt" aria-pressed="false">PT</button>
        </div>
      </div>
    </header>

    <aside class="legacy-notice" aria-label="Compatibility status">
      <strong>LEGACY COMPATIBILITY</strong>
      <span>{historicalMeaning}</span>
      <code>{blocker}</code>
    </aside>

    <main class="legacy-main">
      <slot />
    </main>

    <footer class="legacy-footer">
      <span>renan.snelabs.space</span>
      <span>preserved public semantics · non-canonical editorial surface</span>
    </footer>

    <script is:inline>
      (() => {
        const storageKey = 'portfolio-language';
        const buttons = [...document.querySelectorAll('[data-legacy-language-button]')];
        const panels = [...document.querySelectorAll('[data-legacy-language-panel]')];

        const storedLanguage = (() => {
          try {
            const stored = window.localStorage.getItem(storageKey);
            return stored === 'pt' ? 'pt' : 'en';
          } catch {
            return 'en';
          }
        })();

        const applyLanguage = (language) => {
          const normalized = language === 'pt' ? 'pt' : 'en';
          document.documentElement.lang = normalized === 'pt' ? 'pt-BR' : 'en';
          for (const panel of panels) {
            panel.hidden = panel.getAttribute('data-legacy-language-panel') !== normalized;
          }
          for (const button of buttons) {
            button.setAttribute('aria-pressed', String(button.getAttribute('data-legacy-language-button') === normalized));
          }
          try {
            window.localStorage.setItem(storageKey, normalized);
          } catch {
            // Legacy state remains usable even when storage is unavailable.
          }
          window.dispatchEvent(new CustomEvent('legacy-language-change', { detail: { language: normalized } }));
        };

        for (const button of buttons) {
          button.addEventListener('click', () => applyLanguage(button.getAttribute('data-legacy-language-button')));
        }

        applyLanguage(storedLanguage);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #080a0d;
    color: #e5e7eb;
  }

  * { box-sizing: border-box; }
  html { background: #080a0d; }
  body { margin: 0; min-height: 100vh; background: #080a0d; }
  a { color: inherit; }
  button { font: inherit; }

  .legacy-header,
  .legacy-notice,
  .legacy-main,
  .legacy-footer {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .legacy-header {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #26303a;
  }

  .legacy-identity,
  .legacy-status,
  .legacy-language-switch,
  .legacy-notice,
  .legacy-footer,
  .legacy-meta,
  .legacy-kicker,
  .legacy-badge,
  .legacy-section-title,
  .legacy-fact-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .legacy-identity {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
    text-decoration: none;
  }

  .legacy-header-actions { display: flex; align-items: center; gap: 18px; }
  .legacy-status { color: #7d8792; font-size: 10px; letter-spacing: .08em; }
  .legacy-language-switch { display: flex; border: 1px solid #26303a; }
  .legacy-language-switch button {
    min-width: 42px;
    border: 0;
    border-right: 1px solid #26303a;
    padding: 8px 10px;
    background: transparent;
    color: #7d8792;
    cursor: pointer;
    font-size: 11px;
  }
  .legacy-language-switch button:last-child { border-right: 0; }
  .legacy-language-switch button[aria-pressed="true"] { background: #15202b; color: #78b7ff; }

  .legacy-notice {
    margin-top: 22px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: baseline;
    padding: 13px 15px;
    border-left: 2px solid #d79a48;
    background: #0e1217;
    color: #8e98a3;
    font-size: 11px;
    line-height: 1.5;
  }
  .legacy-notice strong { color: #d79a48; letter-spacing: .08em; }
  .legacy-notice code { color: #68727d; overflow-wrap: anywhere; }

  .legacy-main { padding: 66px 0 110px; }
  .legacy-footer {
    min-height: 78px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    border-top: 1px solid #26303a;
    color: #626c76;
    font-size: 10px;
  }

  .legacy-kicker { color: #58a6ff; font-size: 11px; letter-spacing: .11em; text-transform: uppercase; }
  .legacy-title {
    margin: 14px 0 18px;
    max-width: 980px;
    color: #dcecff;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(32px, 5vw, 64px);
    line-height: 1.02;
    letter-spacing: -.035em;
  }
  .legacy-lede { max-width: 860px; margin: 0; color: #aab2bb; font-size: 18px; line-height: 1.65; }
  .legacy-meta { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 8px 18px; color: #7d8792; font-size: 11px; }
  .legacy-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .legacy-badge { display: inline-flex; border: 1px solid #2b3946; padding: 6px 9px; color: #8cc6ff; font-size: 10px; letter-spacing: .05em; }

  .legacy-section { margin-top: 58px; padding-top: 28px; border-top: 1px solid #26303a; }
  .legacy-section-title { margin: 0 0 18px; color: #58a6ff; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
  .legacy-copy { max-width: 860px; color: #c5cbd2; font-size: 16px; line-height: 1.7; }
  .legacy-list { display: grid; gap: 12px; margin: 0; padding-left: 20px; color: #c5cbd2; line-height: 1.62; }

  .legacy-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: #26303a; border: 1px solid #26303a; }
  .legacy-card { background: #0d1117; padding: 20px; }
  .legacy-card h3 { margin: 0 0 12px; color: #7ee2a8; font: 600 12px/1.5 ui-monospace, monospace; letter-spacing: .05em; }
  .legacy-card ul { margin: 0; padding-left: 18px; color: #aab2bb; line-height: 1.55; }

  .legacy-flow { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .legacy-flow-step { flex: 1 1 150px; min-height: 86px; border: 1px solid #26303a; padding: 14px; background: #0d1117; color: #c5cbd2; }
  .legacy-flow-step span { display: block; margin-bottom: 8px; color: #7ee2a8; font: 10px ui-monospace, monospace; }

  .legacy-state-chain { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .legacy-state { border: 1px solid #2b6648; padding: 10px 14px; color: #7ee2a8; font: 12px ui-monospace, monospace; }

  .legacy-link-list { display: flex; flex-wrap: wrap; gap: 10px; }
  .legacy-link { display: inline-flex; border: 1px solid #2b3946; padding: 10px 12px; color: #8cc6ff; text-decoration: none; font: 11px ui-monospace, monospace; }

  .legacy-disclosure { margin-top: 20px; padding: 14px 16px; border-left: 2px solid #d79a48; color: #9ca6b0; background: #0e1217; line-height: 1.6; }

  @media (max-width: 820px) {
    .legacy-header { align-items: flex-start; flex-direction: column; padding: 20px 0; }
    .legacy-header-actions { width: 100%; justify-content: space-between; }
    .legacy-notice { grid-template-columns: 1fr; }
    .legacy-grid { grid-template-columns: 1fr; }
    .legacy-footer { align-items: flex-start; flex-direction: column; justify-content: center; }
  }
</style>
