---
import type { CompatibilityRedirectEntry } from '../../../src/editorial/compatibility-redirect-adapter';

interface Props {
  entry: CompatibilityRedirectEntry;
  endpoint: string;
  storageKey: 'portfolio-language';
}

const { entry, endpoint, storageKey } = Astro.props;
---
<!doctype html>
<html lang="en" data-compatibility-redirect-handshake>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,follow" />
    <title>Compatibility redirect — Renan Melo</title>
  </head>
  <body>
    <main>
      <p class="kicker">LEGACY COMPATIBILITY</p>
      <h1>Resolving the canonical successor…</h1>
      <p>
        This historical route uses the existing <code>{storageKey}</code> client state before requesting a bounded HTTP redirect.
      </p>
      <noscript>
        <p>JavaScript is required to read the historical client-language state. Choose a canonical destination:</p>
        <div class="links">
          <a href={entry.successors.en}>English</a>
          <a href={entry.successors['pt-BR']}>Português</a>
        </div>
      </noscript>
    </main>

    <script is:inline define:vars={{ legacyPath: entry.legacyPath, endpoint, storageKey }}>
      (() => {
        let stored = 'en';
        try {
          stored = window.localStorage.getItem(storageKey) === 'pt' ? 'pt' : 'en';
        } catch {
          stored = 'en';
        }
        const params = new URLSearchParams({ from: legacyPath, lang: stored });
        window.location.replace(`${endpoint}?${params.toString()}`);
      })();
    </script>
  </body>
</html>

<style>
  :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #080a0d; color: #e5e7eb; }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #080a0d; }
  main { width: min(680px, calc(100% - 40px)); border: 1px solid #26303a; background: #0d1117; padding: 32px; }
  .kicker, code, a { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .kicker { color: #58a6ff; font-size: 11px; letter-spacing: .12em; }
  h1 { margin: 12px 0 18px; font: 600 clamp(26px, 5vw, 44px)/1.08 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: #dcecff; }
  p { color: #aab2bb; line-height: 1.65; }
  code { color: #7ee2a8; }
  .links { display: flex; gap: 10px; margin-top: 18px; }
  a { border: 1px solid #2b3946; padding: 9px 12px; color: #8cc6ff; text-decoration: none; font-size: 12px; }
</style>
